# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Renombra este archivo a 'application.properties' 
# y reemplaza los valores con los tuyos locales.
# ==========================================

spring.application.name=backend

# Conexión a la base de datos MySQL
spring.datasource.url=jdbc:mysql://localhost:3306/gestorRecursos_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=TU_USUARIO_MYSQL
spring.datasource.password=TU_CONTRASEÑA_MYSQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Configuración de JPA (Hibernate)
spring.jpa.generate-ddl=false
spring.jpa.show-sql=true
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl