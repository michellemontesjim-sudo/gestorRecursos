# Copia este archivo con el nombre .env y reemplaza los valores con los tuyos.
# El archivo .env NO se sube a GitHub (está en el .gitignore).

# Base de datos (MySQL)
DB_URL=jdbc:mysql://localhost:3306/gestorRecursos_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql

# Cloudinary (almacenamiento de los archivos subidos). Pide los valores al equipo por privado.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Correo para los envíos del sistema (Gmail con contraseña de aplicación). Pide los valores al equipo por privado.
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion

# Clave para firmar los tokens de inicio de sesión (JWT). Cualquier texto de mínimo 32 caracteres.
JWT_SECRET=cambia_esto_por_una_clave_larga_de_minimo_32_caracteres
